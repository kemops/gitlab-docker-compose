# ===== GitLab Configuration =====
# Copy this file to .env and update with your actual values:
#   cp .env.example .env

# Hostname ของ container (ไม่ต้องเป็น domain จริง)
GITLAB_HOSTNAME=gitlab

# External URL ที่ใช้เข้าถึง GitLab
# ตัวอย่าง: http://192.168.1.100:8000  หรือ  https://gitlab.example.com
GITLAB_EXTERNAL_URL=http://localhost:8000

# Timezone
GITLAB_TIMEZONE=Asia/Bangkok

# Ports (host side)
GITLAB_HTTP_PORT=8000
GITLAB_HTTPS_PORT=8443
GITLAB_SSH_PORT=2222